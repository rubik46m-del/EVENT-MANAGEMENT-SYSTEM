# EVENT-MANAGEMENT-SYSTEM
<!DOCTYPE html>
<html>
<head>
    <title>Event Management System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>Event Management System</h1>
    <nav>
        <a href="#home">Home</a>
        <a href="#events">Events</a>
        <a href="#booking">Book Ticket</a>
    </nav>
</header>

<section id="home">
    <h2>Welcome to Event Management System</h2>
    <p>Book tickets for your favorite events online.</p>
</section>

<section id="events">
    <h2>Upcoming Events</h2>

    <div class="card">
        <h3>Tech Conference 2026</h3>
        <p>Date: 20 June 2026</p>
        <p>Location: Chennai</p>
    </div>

    <div class="card">
        <h3>Music Festival</h3>
        <p>Date: 25 June 2026</p>
        <p>Location: Bangalore</p>
    </div>

    <div class="card">
        <h3>Startup Meetup</h3>
        <p>Date: 30 June 2026</p>
        <p>Location: Hyderabad</p>
    </div>
</section>

<section id="booking">
    <h2>Ticket Booking</h2>

    <form id="bookingForm">
        <input type="text" id="name" placeholder="Enter Name" required>

        <input type="email" id="email" placeholder="Enter Email" required>

        <select id="event">
            <option>Tech Conference 2026</option>
            <option>Music Festival</option>
            <option>Startup Meetup</option>
        </select>

        <input type="number" id="tickets" placeholder="Number of Tickets" required>

        <button type="submit">Book Now</button>
    </form>

    <div id="message"></div>
</section>

<script src="script.js"></script>

</body>
</html>
